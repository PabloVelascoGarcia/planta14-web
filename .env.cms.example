# Copy to .env.local only in the isolated development checkout. Never reuse production resources.
CMS_ENABLED=false
CONTENT_SOURCE=demo
IMPORT_MUNICIPAL_DEMO=false
PAYLOAD_SECRET=
DATABASE_URL=postgres://planta14:local-development-only@127.0.0.1:55432/planta14
CMS_SERVER_URL=http://localhost:3000
S3_BUCKET=planta14-development
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
# Only for the explicit bootstrap command; remove immediately after use.
CMS_BOOTSTRAP_EMAIL=
CMS_BOOTSTRAP_PASSWORD=
# Public copies of publishable images (bloque 3). Base URL of the public bucket/CDN; empty = public pages use the placeholder.
# Recommended: a SEPARATE public bucket. Never grant anonymous read to the private S3_BUCKET.
# Local S3rver example: http://127.0.0.1:59000/planta14-development-public
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_BUCKET=planta14-development-public
PUBLIC_MEDIA_PREFIX=public
PUBLIC_MEDIA_CACHE_CONTROL="public, max-age=86400"
# Objects younger than this are never treated as orphans by cms:media:sync-public.
PUBLIC_MEDIA_ORPHAN_GRACE_SECONDS=600
# CDN purge hook, called on withdrawal, unpublication and deletion. Disabled until a CDN is contracted.
# Generic contract: POST {"urls": [...]} to CDN_PURGE_URL with "Authorization: Bearer CDN_PURGE_TOKEN".
CDN_PURGE_ENABLED=false
CDN_PURGE_URL=
CDN_PURGE_TOKEN=
# Email notice to Planta 14 for each municipal publication: prepared, disabled until a mail provider exists.
MUNICIPAL_NOTICE_EMAIL_ENABLED=false
MUNICIPAL_NOTICE_EMAIL_TO=
# Launch: search indexing only with SITE_INDEXABLE=true (production). GA4 ID loads only after cookie consent.
SITE_INDEXABLE=false
GA4_MEASUREMENT_ID=
