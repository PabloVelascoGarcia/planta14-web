# Plantilla del entorno de pruebas. Copia a infra/.env.staging (ignorado por Git) y rellena.
# NO pongas aquí valores reales. Genera secretos con:  openssl rand -hex 32
# Usa solo caracteres [A-Za-z0-9] en contraseñas: van dentro de DATABASE_URL.

COMPOSE_PROJECT_NAME=planta14-staging
# "minio" activa el S3 de pruebas. Vacío cuando se use un S3 real.
COMPOSE_PROFILES=minio

# --- Dominio y HTTPS ---------------------------------------------------------------------
# Nombre DNS que apunta al servidor (registro A/AAAA). Ej.: staging.example.org
STAGING_DOMAIN=
# Email de contacto para Let's Encrypt, o "internal" para un certificado local de pruebas.
CADDY_TLS=
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
# Acceso exterior obligatorio. Hash bcrypt de `caddy hash-password`, nunca contraseña en claro.
CADDY_BASIC_AUTH_USER=planta14
# Usa comillas simples al rellenar: CADDY_BASIC_AUTH_HASH='$2a$...'
CADDY_BASIC_AUTH_HASH=

# --- Aplicación / Payload ----------------------------------------------------------------
# Fijados también en Compose: staging no debe arrancar en modo demo.
CMS_ENABLED=true
CONTENT_SOURCE=payload
# Mínimo 32 caracteres aleatorios.
PAYLOAD_SECRET=
APP_IMAGE=planta14-app:staging
NODE_IMAGE=node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
APP_MEM_LIMIT=2g

# --- PostgreSQL 17 -----------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
POSTGRES_DB=planta14
# Superusuario: solo administración y copias. Nunca lo usa la aplicación.
POSTGRES_USER=planta14
POSTGRES_PASSWORD=
# Migraciones (propietario del esquema public). Solo lo usa el servicio "migrate".
POSTGRES_MIGRATOR_USER=planta14_migrator
POSTGRES_MIGRATOR_PASSWORD=
# Aplicación: solo SELECT/INSERT/UPDATE/DELETE; no puede crear ni borrar tablas.
POSTGRES_APP_USER=planta14_app
POSTGRES_APP_PASSWORD=
POSTGRES_MEM_LIMIT=2g
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAX_CONNECTIONS=50

# --- Almacenamiento S3 -------------------------------------------------------------------
# Con MinIO: endpoint interno http://minio:9000 y path style. Con un S3 real: datos del proveedor (HTTPS).
S3_BUCKET=planta14-staging
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Clave de la aplicación (limitada al bucket). Con MinIO la crea minio-init.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Imágenes públicas (bloque 3) --------------------------------------------------------
# Se recomienda un bucket PÚBLICO SEPARADO del privado: el privado no se publica nunca.
# Con MinIO de pruebas, Caddy sirve el bucket público en https://<STAGING_DOMAIN>/media
# (tras la contraseña de staging). Con un CDN/S3 real: su URL https (raíz del bucket público).
# Tras "npm run cms:migrate" del bloque 3, ejecuta una vez "npm run cms:media:sync-public".
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_BUCKET=planta14-staging-public
PUBLIC_MEDIA_PREFIX=public
PUBLIC_MEDIA_CACHE_CONTROL='public, max-age=86400'
PUBLIC_MEDIA_ORPHAN_GRACE_SECONDS=600
# Purga del CDN al retirar/despublicar/borrar: desactivada hasta que haya proveedor.
CDN_PURGE_ENABLED=false
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# --- MinIO (solo pruebas) ----------------------------------------------------------------
# minio/minio ya no existe en Docker Hub. Imagen pendiente de decidir (docs/INFRA-STAGING.md);
# no se ha podido fijar por digest porque quay.io no es accesible desde el entorno de pruebas.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=
# 16+ caracteres.
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=9001

# --- Copias de seguridad (infra/backup) ----------------------------------------------------
BACKUP_DIR=/var/backups/planta14
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
# none | age | gpg. Recomendado: age con la clave PÚBLICA; la privada fuera del servidor.
BACKUP_ENCRYPTION=none
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# Contenedor de PostgreSQL para pg_dump/pg_restore. Vacío = <COMPOSE_PROJECT_NAME>-postgres-1; "none" = pg_dump del host.
PG_CONTAINER=
RCLONE_IMAGE=rclone/rclone:1.71.2@sha256:3103526c506266a9ecdf064efe99bf3677d92ef6407af124d8c56b4f49cbaa51
# Red para LEER el almacenamiento. Vacío = automática: <proyecto>_backend si S3_ENDPOINT es MinIO
# del propio Compose; si es un S3 externo, la red de salida BACKUP_EGRESS_NETWORK.
BACKUP_DOCKER_NETWORK=
# Red de salida de los trabajos de copia: puente propio, sin PostgreSQL ni la red interna.
BACKUP_EGRESS_NETWORK=planta14-backup-egress

# --- Copia fuera del servidor (infra/backup/offsite-sync.sh) ---------------------------------
# Otro proveedor u otra región. Clave PROPIA que pueda escribir pero NO borrar; retención y
# bloqueo de objetos configurados en el proveedor. Solo se suben copias cifradas (.age/.gpg).
OFFSITE_BUCKET=
OFFSITE_PREFIX=planta14/staging
OFFSITE_ENDPOINT=
OFFSITE_REGION=
OFFSITE_FORCE_PATH_STYLE=false
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_ALLOW_UNENCRYPTED=false

# --- Lanzamiento -----------------------------------------------------------------------------
# Indexación en buscadores: SOLO en producción y el día de la salida pública. Staging: false.
SITE_INDEXABLE=false
# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica ni banner. Solo se carga tras aceptar.
GA4_MEASUREMENT_ID=

# --- Alertas por correo (infra/monitor) --------------------------------------------------------
# Desactivadas hasta contratar correo: mientras, se anotan en ALERT_LOG.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_URL=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_LOG=/var/backups/planta14/alerts.log
ALERT_DISK_THRESHOLD=80
ALERT_DISK_PATHS='/ /var/lib/docker /var/backups/planta14'
