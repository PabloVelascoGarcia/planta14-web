# Plantilla del entorno de pruebas. Copia a infra/.env.staging (ignorado por Git) y rellena.
# NO pongas aquí valores reales. Genera secretos con:  openssl rand -hex 32
# Usa solo caracteres [A-Za-z0-9] en contraseñas: van dentro de DATABASE_URL.

COMPOSE_PROJECT_NAME=planta14-staging
# "minio" activa el S3 de pruebas. Vacío cuando se use un S3 real.
COMPOSE_PROFILES=minio

# --- Dominio y HTTPS ---------------------------------------------------------------------
# Nombre DNS que apunta al servidor (registro A/AAAA). Ej.: staging.example.org
STAGING_DOMAIN=
# Email de contacto para Let's Encrypt, o "internal" para un certificado local de pruebas.
CADDY_TLS=
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
# Acceso exterior obligatorio. Hash bcrypt de `caddy hash-password`, nunca contraseña en claro.
CADDY_BASIC_AUTH_USER=planta14
# Usa comillas simples al rellenar: CADDY_BASIC_AUTH_HASH='$2a$...'
CADDY_BASIC_AUTH_HASH=

# --- Aplicación / Payload ----------------------------------------------------------------
# Fijados también en Compose: staging no debe arrancar en modo demo.
CMS_ENABLED=true
CONTENT_SOURCE=payload
# Mínimo 32 caracteres aleatorios.
PAYLOAD_SECRET=
APP_IMAGE=planta14-app:staging
NODE_IMAGE=node:22.23.4-bookworm-slim
APP_MEM_LIMIT=2g

# --- PostgreSQL 17 -----------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_DB=planta14
POSTGRES_USER=planta14
POSTGRES_PASSWORD=
POSTGRES_MEM_LIMIT=2g
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAX_CONNECTIONS=50

# --- Almacenamiento S3 -------------------------------------------------------------------
# Con MinIO: endpoint interno http://minio:9000 y path style. Con un S3 real: datos del proveedor (HTTPS).
S3_BUCKET=planta14-staging
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Clave de la aplicación (limitada al bucket). Con MinIO la crea minio-init.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- MinIO (solo pruebas) ----------------------------------------------------------------
# minio/minio ya no existe en Docker Hub. Imagen pendiente de decidir (docs/INFRA-STAGING.md).
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=
# 16+ caracteres.
MINIO_ROOT_PASSWORD=
MINIO_CONSOLE_PORT=9001

# --- Copias de seguridad (infra/backup) ----------------------------------------------------
BACKUP_DIR=/var/backups/planta14
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
# none | age | gpg. Recomendado: age con la clave PÚBLICA; la privada fuera del servidor.
BACKUP_ENCRYPTION=none
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# Contenedor de PostgreSQL (nombre de Compose) para pg_dump/pg_restore.
PG_CONTAINER=planta14-staging-postgres-1
# Copia del almacenamiento con rclone (en contenedor, en la red interna de Compose).
RCLONE_IMAGE=rclone/rclone:1.71.2
BACKUP_DOCKER_NETWORK=planta14-staging_backend
