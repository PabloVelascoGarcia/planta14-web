# Plantilla del entorno de PRODUCCIÓN (planta14.com). Copia a infra/.env.production en el servidor
# (permisos 600, nunca en Git) o genérala con infra/deploy/generate-production-env.sh.
# NO pongas aquí valores reales. Contraseñas PostgreSQL solo con [A-Za-z0-9]: van dentro de DATABASE_URL.

COMPOSE_PROJECT_NAME=planta14

# --- Dominio y HTTPS -----------------------------------------------------------------------------
# planta14.com, o pruebas.planta14.com para la instalación de prueba (generate-production-env.sh --pruebas).
SITE_DOMAIN=planta14.com
# on = www.SITE_DOMAIN redirige a SITE_DOMAIN (planta14.com); off = sin www (pruebas.planta14.com).
CADDY_WWW_REDIRECT=on

# --- Preproducción (pruebas.planta14.com) ------------------------------------------------------------
# on = toda la web pide una contraseña común (salvo /api/health). Se quita con off + aplicar-caddy.sh.
# Hash: docker run --rm -it caddy:2.10.2-alpine caddy hash-password  → pégalo ENTRE COMILLAS SIMPLES.
PREPRODUCTION_AUTH=off
PREPRODUCTION_AUTH_USER=planta14
PREPRODUCTION_AUTH_HASH=
# Tras pasar a planta14.com: el dominio de preproducción redirige al definitivo (on + el dominio anterior).
CADDY_PREVIOUS_DOMAIN_REDIRECT=off
SITE_PREVIOUS_DOMAIN=
# Correo para los avisos de Let's Encrypt (caducidad de certificados).
ACME_EMAIL=
# acme = Let's Encrypt (producción). "internal" solo para ensayos locales.
CADDY_TLS_MODE=acme
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
CADDY_LOG_DIR=/var/log/planta14/caddy

# --- Decisión explícita: indexación en buscadores --------------------------------------------------
# true  = Google y otros buscadores pueden indexar la web (día de la salida pública).
# false = noindex en todas las respuestas (antes de la salida).
# Sin valor, Compose y el despliegue se niegan a arrancar.
SITE_INDEXABLE=

# --- Aplicación -------------------------------------------------------------------------------------
PAYLOAD_SECRET=
APP_MEM_LIMIT=1024m
APP_MEMSWAP_LIMIT=1536m
MIGRATE_MEM_LIMIT=768m
MIGRATE_MEMSWAP_LIMIT=1024m
CADDY_MEM_LIMIT=128m
CADDY_MEMSWAP_LIMIT=192m
BUILD_MEMORY_BYTES=1342177280
BUILD_MEMORY_SWAP_BYTES=2684354560
# Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica ni banner de cookies.
GA4_MEASUREMENT_ID=

# --- PostgreSQL 17 ----------------------------------------------------------------------------------
POSTGRES_DB=planta14
POSTGRES_USER=planta14
POSTGRES_PASSWORD=
POSTGRES_MIGRATOR_USER=planta14_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APP_USER=planta14_app
POSTGRES_APP_PASSWORD=
POSTGRES_MEM_LIMIT=640m
POSTGRES_MEMSWAP_LIMIT=768m
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_MAX_CONNECTIONS=30

# --- Almacenamiento: IONOS Object Storage (panel de IONOS) -------------------------------------------
# Tres buckets y UNA sola clave de acceso, del propietario (puede todo en los tres; no hay identidades
# separadas). Endpoints oficiales de IONOS para buckets «de contrato», tabla «Endpoints» de
# https://docs.ionos.com/cloud/storage-and-backup/ionos-object-storage/endpoints :
#   Berlín     eu-central-3   https://s3.eu-central-3.ionoscloud.com
#   Fráncfort  eu-central-4   https://s3.eu-central-4.ionoscloud.com
# Bucket PRIVADO de originales (Berlín).
S3_BUCKET=planta14-originales-b11
S3_REGION=eu-central-3
S3_ENDPOINT=https://s3.eu-central-3.ionoscloud.com
S3_FORCE_PATH_STYLE=false
# La clave única del panel (Access Key / Secret Key). Solo aquí y en el gestor de contraseñas.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket PÚBLICO de imágenes publicadas (Berlín, mismo endpoint) y la URL https con la que se leen.
# Comprueba la URL con una imagen de prueba antes de abrir (docs/PUESTA-EN-MARCHA-IONOS.md, apartado 3).
PUBLIC_MEDIA_BUCKET=planta14-imagenes-b11
PUBLIC_MEDIA_BASE_URL=https://planta14-imagenes-b11.s3.eu-central-3.ionoscloud.com
PUBLIC_MEDIA_PREFIX=public
PUBLIC_MEDIA_CACHE_CONTROL='public, max-age=86400'
PUBLIC_MEDIA_ORPHAN_GRACE_SECONDS=600
CDN_PURGE_ENABLED=false
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# --- Correo transaccional (avisos municipales y alertas) ----------------------------------------------
# Buzón IONOS avisos@planta14.com, smtp.ionos.es:465 SSL/TLS.
# Activa tras introducir la contraseña del buzón y probar entrega/recuperación.
SMTP_ENABLED=false
SMTP_PASSWORD=
MUNICIPAL_NOTICE_EMAIL_ENABLED=false
MUNICIPAL_NOTICE_EMAIL_TO=
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_URL=smtps://smtp.ionos.es:465
ALERT_SMTP_USER=avisos@planta14.com
# Vacía: reutiliza SMTP_PASSWORD. No pegues la contraseña aquí dos veces.
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=avisos@planta14.com
ALERT_EMAIL_TO=
ALERT_LOG=/var/backups/planta14/alerts.log
ALERT_MEMORY_THRESHOLD=85
ALERT_MEMORY_SECONDS=600
ALERT_DISK_THRESHOLD=80
ALERT_DISK_PATHS='/ /var/lib/docker /var/backups/planta14'

# --- Copias de seguridad ------------------------------------------------------------------------------
RCLONE_MEM_LIMIT=256m
RCLONE_MEMSWAP_LIMIT=384m
BACKUP_DIR=/var/backups/planta14
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=3
# Producción: age obligatorio. Solo la clave PÚBLICA en el servidor.
BACKUP_ENCRYPTION=age
BACKUP_AGE_RECIPIENT=
# Vacío = planta14-postgres-1 (proyecto Compose).
PG_CONTAINER=
RCLONE_IMAGE=rclone/rclone:1.71.2@sha256:3103526c506266a9ecdf064efe99bf3677d92ef6407af124d8c56b4f49cbaa51
BACKUP_DOCKER_NETWORK=
BACKUP_EGRESS_NETWORK=planta14-backup-egress
# Clave para copiar el bucket de originales. Vacía = la clave única (S3_*): es lo previsto en IONOS.
STORAGE_BACKUP_ACCESS_KEY_ID=
STORAGE_BACKUP_SECRET_ACCESS_KEY=
# Copia fuera del servidor: bucket de copias en OTRA región (Fráncfort), con bloqueo de objetos en modo
# compliance de 30 días. Ese bloqueo es la protección de las copias: durante 30 días nadie, ni quien robe la
# clave única, puede destruir ni alterar una copia guardada (como mucho, ocultarla con un marcador de borrado
# o subir otra versión encima; la original sigue y se recupera). offsite-sync.sh además nunca lo intenta.
OFFSITE_BUCKET=planta14-copias-b11
OFFSITE_PREFIX=planta14/produccion
OFFSITE_ENDPOINT=https://s3.eu-central-4.ionoscloud.com
OFFSITE_REGION=eu-central-4
OFFSITE_FORCE_PATH_STYLE=false
# Vacías = la clave única (S3_*).
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_ALLOW_UNENCRYPTED=false

# --- Despliegue (infra/deploy) ------------------------------------------------------------------------
# Segundos de espera de /api/health tras arrancar una versión.
DEPLOY_HEALTH_TIMEOUT=180
# Imágenes de versiones anteriores que se conservan para volver atrás.
DEPLOY_KEEP_IMAGES=3
# Carpeta del modo mantenimiento: si contiene el archivo "activo", el /cms, la API de escritura y los paneles
# municipales pasan a solo lectura (lo gestionan deploy.sh, restaurar.sh y mantenimiento.sh).
MAINTENANCE_DIR=/srv/planta14/mantenimiento

# --- Sección «Útil» ---------------------------------------------------------------------------------
# Clave de AEMET OpenData (https://opendata.aemet.es/centrodedescargas/inicio). Vacía = el bloque del tiempo no sale.
# Las claves nuevas caducan a los tres meses: renuévala a tiempo. Ponla aquí directamente; no la compartas por chat.
AEMET_API_KEY=
# Cada cuántas horas se refresca la BDNS (subvenciones). Las visitas nunca la consultan directamente.
UTIL_BDNS_REFRESH_HOURS=6
