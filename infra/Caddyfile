# Proxy inverso con HTTPS automático para staging.
# STAGING_DOMAIN: nombre DNS que apunta al servidor.
# CADDY_TLS: "internal" (certificado propio, pruebas locales) o el email para Let's Encrypt.
{
	admin off
}

(staging_security_headers) {
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "private, no-store"
		-Server
	}
}

{$STAGING_DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip
	import staging_security_headers
	# No hay rutas públicas de aplicación, ni siquiera /cms o los archivos estáticos.
	basic_auth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}

	# Los desafíos 401 y los errores del proxy también deben llevar noindex y no-store.
	handle_errors {
		import staging_security_headers
		respond "{err.status_text}" {err.status_code}
	}

	# Cargas del CMS: 10 MiB por imagen, con margen para el multipart.
	request_body {
		max_size 12MB
	}

	# Bloque 3 con MinIO de pruebas: PUBLIC_MEDIA_BASE_URL=https://<dominio>/media sirve el bucket
	# público (PUBLIC_MEDIA_BUCKET) por la red public_media. Solo lectura, sin consulta (?...), sin
	# "..", sin credenciales hacia MinIO. El bucket privado depende además de la política de MinIO.
	# Con un CDN o un S3 público real, PUBLIC_MEDIA_BASE_URL apunta a ese servicio y esta ruta no se usa.
	handle_path /media/* {
		@media_unsafe {
			not method GET HEAD
		}
		respond @media_unsafe 405
		@media_traversal path_regexp `\.\.|\\|%`
		respond @media_traversal 400
		rewrite * /{$PUBLIC_MEDIA_BUCKET}{path}
		reverse_proxy {$PUBLIC_MEDIA_UPSTREAM} {
			header_up -Authorization
			header_up -Cookie
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy app:3000 {
			# Payload usa su propia cookie; no se reenvía la contraseña de la barrera exterior.
			header_up -Authorization
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}
