# Proxy inverso con HTTPS automático para staging.
# STAGING_DOMAIN: nombre DNS que apunta al servidor.
# CADDY_TLS: "internal" (certificado propio, pruebas locales) o el email para Let's Encrypt.
{
	admin off
}

{$STAGING_DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip

	# El entorno de pruebas no debe indexarse.
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Cargas del CMS: 10 MiB por imagen, con margen para el multipart.
	request_body {
		max_size 12MB
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}
