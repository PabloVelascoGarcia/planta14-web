# Caddy de producción de Planta 14: web pública (sin contraseña), HTTPS automático de Let's Encrypt para
# SITE_DOMAIN y www.SITE_DOMAIN, con www redirigido a SITE_DOMAIN (salvo CADDY_WWW_REDIRECT=off). /api/health queda abierto para el monitor
# externo. Los intentos de inicio de sesión se limitan con fail2ban (infra/server/fail2ban) a partir de este
# registro de accesos, y Payload bloquea además cada cuenta tras 5 fallos durante 10 minutos.
{
	email {$ACME_EMAIL}
	admin off
}

(tls_acme) {
}

(tls_internal) {
	tls internal
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# www.SITE_DOMAIN redirige a SITE_DOMAIN (planta14.com). CADDY_WWW_REDIRECT=off lo omite: para dominios sin
# www en el DNS, como pruebas.planta14.com, así Caddy no pide a Let's Encrypt un certificado imposible.
(www_on) {
	www.{$SITE_DOMAIN} {
		import tls_{$CADDY_TLS_MODE:acme}
		import security_headers
		redir https://{$SITE_DOMAIN}{uri} permanent
	}
}

(www_off) {
}

import www_{$CADDY_WWW_REDIRECT:on}

# Dominio anterior (pruebas.planta14.com tras la salida): redirige de forma permanente al actual conservando
# la ruta, para que no se pierdan los enlaces. SITE_PREVIOUS_DOMAIN y CADDY_PREVIOUS_DOMAIN_REDIRECT=on.
(previous_on) {
	{$SITE_PREVIOUS_DOMAIN} {
		import tls_{$CADDY_TLS_MODE:acme}
		import security_headers
		redir https://{$SITE_DOMAIN}{uri} permanent
	}
}

(previous_off) {
}

import previous_{$CADDY_PREVIOUS_DOMAIN_REDIRECT:off}

# Modo preproducción: toda la web pide una contraseña común (autenticación básica; hash bcrypt en
# PREPRODUCTION_AUTH_HASH), salvo /api/health (monitor externo y despliegue) y la comprobación del modo
# mantenimiento que hace deploy.sh. Se quita con PREPRODUCTION_AUTH=off e infra/deploy/aplicar-caddy.sh.
(preproduction_on) {
	@preproduction_protected not path /api/health /api/cms/comprobacion-mantenimiento
	basic_auth @preproduction_protected {
		{$PREPRODUCTION_AUTH_USER:planta14} {$PREPRODUCTION_AUTH_HASH}
	}
}

(preproduction_off) {
}

{$SITE_DOMAIN} {
	import tls_{$CADDY_TLS_MODE:acme}
	import security_headers
	import preproduction_{$PREPRODUCTION_AUTH:off}
	encode zstd gzip

	# Cargas del CMS: 10 MiB por imagen, con margen para el multipart.
	request_body {
		max_size 12MB
	}

	# Modo mantenimiento (infra/deploy/mantenimiento.sh y deploy.sh): mientras exista el archivo "activo" en la
	# carpeta montada, se rechaza toda escritura (sin reconstruir ni reiniciar: se comprueba en cada petición).
	# La lectura sigue funcionando: web pública, /cms y paneles. Se permiten: iniciar y cerrar sesión, las
	# lecturas de Payload por POST (X-Payload-HTTP-Method-Override: GET) y las funciones de servidor del /cms,
	# que la propia app bloquea si escriben (cms/maintenance.ts).
	@maintenance_write {
		file {
			root /srv/mantenimiento
			try_files /activo
		}
		not method GET HEAD OPTIONS
		not path /cms /cms/* /api/cms/users/login /api/cms/users/logout /api/cms/users/refresh-token
		not header X-Payload-HTTP-Method-Override GET
	}
	handle @maintenance_write {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "300"
		respond `{"errors":[{"message":"Planta 14 se está actualizando. Durante unos minutos puedes consultarlo todo, pero no guardar cambios. Lo publicado sigue en la web. Vuelve a intentarlo en un rato."}],"maintenance":true}` 503
	}

	# Monitor externo de disponibilidad: nunca en caché.
	handle /api/health {
		header Cache-Control "no-store"
		reverse_proxy app:3000
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}
