CMS_AUTH_SECRET=change-this-long-random-secret
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-this-password
CMS_REDACTOR_EMAIL=redactor@example.com
CMS_REDACTOR_PASSWORD=change-this-password-too

# The current editorial presentation is active by default in this branch.
# To show the original sample stories instead: DEMO_CONTENT=example
# The presentation is public, without a password, and always noindex.
SITE_INDEXABLE=false
# Set the real canonical URL only when the public launch is ready.
# SITE_URL=https://planta14.com
